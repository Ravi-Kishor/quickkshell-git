#!/bin/bash
set -euo pipefail

REPO="Ravi-Kishor/quickshell-git"
PKG_NAME="quickshell-git"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "❌ Required command '$1' not found"
    exit 1
  }
}

require aria2c
require curl
require jq
require sudo
require pacman

get_installed_version() {
  pacman -Q "$PKG_NAME" 2>/dev/null | awk '{print $2}' || echo "Not Installed"
}

INSTALLED_VERSION=$(get_installed_version)

echo "Installed package version: $INSTALLED_VERSION"
echo "📡 Fetching latest release metadata…"

RELEASE_JSON=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest")

TAG_NAME=$(echo "$RELEASE_JSON" | jq -r '.tag_name')
echo "Latest release tag: $TAG_NAME"

# Find quickshell asset (prefer v3)
QUICKSHELL_URL=$(echo "$RELEASE_JSON" | jq -r '
  .assets[]
  | select(.name | test("^quickshell-git-.*-x86_64_v3\\.pkg\\.tar\\.zst$"))
  | .browser_download_url
' | head -n1)

if [[ -z "$QUICKSHELL_URL" || "$QUICKSHELL_URL" == "null" ]]; then
  QUICKSHELL_URL=$(echo "$RELEASE_JSON" | jq -r '
    .assets[]
    | select(.name | test("^quickshell-git-.*-x86_64\\.pkg\\.tar\\.zst$"))
    | .browser_download_url
  ' | head -n1)
fi

# Find cpptrace asset
CPPTRACE_URL=$(echo "$RELEASE_JSON" | jq -r '
  .assets[]
  | select(.name | test("^cpptrace-.*\\.pkg\\.tar\\.zst$"))
  | .browser_download_url
' | head -n1)

if [[ -z "$QUICKSHELL_URL" || "$QUICKSHELL_URL" == "null" ]]; then
  echo "❌ Could not find quickshell package"
  exit 1
fi

if [[ -z "$CPPTRACE_URL" || "$CPPTRACE_URL" == "null" ]]; then
  echo "❌ Could not find cpptrace package"
  exit 1
fi

QS_FILE=$(basename "$QUICKSHELL_URL")
CPP_FILE=$(basename "$CPPTRACE_URL")

LATEST_VERSION=$(echo "$QS_FILE" | sed -E \
  's/^quickshell-git-(.*)-x86_64(_v3)?\.pkg\.tar\.zst/\1/')

echo "Latest quickshell version: $LATEST_VERSION"
echo

echo "Choose an action:"
echo "1) Update (skip if already latest)"
echo "2) Force install"
read -rp "Enter choice (1/2): " CHOICE

if [[ "$CHOICE" == "1" ]]; then
  if [[ "$INSTALLED_VERSION" == "$LATEST_VERSION" ]]; then
    echo "✅ quickshell is already up to date"
    exit 0
  fi
  echo "⬆️ Updating quickshell $INSTALLED_VERSION → $LATEST_VERSION"
elif [[ "$CHOICE" == "2" ]]; then
  echo "🛠️ Force installing quickshell $LATEST_VERSION"
else
  echo "❌ Invalid choice"
  exit 1
fi

TMP_DIR=$(mktemp -d)
cd "$TMP_DIR"

echo "📥 Downloading packages..."

aria2c -x 8 -s 8 -k 1M -o "$CPP_FILE" "$CPPTRACE_URL"
aria2c -x 8 -s 8 -k 1M -o "$QS_FILE" "$QUICKSHELL_URL"

echo "📦 Installing packages..."

sudo pacman -U --noconfirm "$CPP_FILE"
sudo pacman -U --noconfirm "$QS_FILE"

cd /
rm -rf "$TMP_DIR"

echo
echo "✅ quickshell $LATEST_VERSION installed successfully!"
