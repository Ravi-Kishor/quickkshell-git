#!/bin/bash
set -euo pipefail

REPO="Ravi-Kishor/quickshell-git"
PKG_NAME="quickshell-git"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "❌ Required command '$1' not found"
    exit 1
  }
}

for cmd in aria2c curl jq sudo pacman vercmp sed awk; do
  require "$cmd"
done

get_installed_version() {
  pacman -Q "$PKG_NAME" 2>/dev/null | awk '{print $2}' || echo ""
}

INSTALLED_VERSION=$(get_installed_version)

echo "------------------------------------------"
echo "  Quickshell Installer (Zen3 build)"
echo "------------------------------------------"
echo "Local:   ${INSTALLED_VERSION:-Not Installed}"
echo "📡 Fetching latest release..."

RELEASE_JSON=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest")

# --- Find quickshell package ---
QUICKSHELL_URL=$(echo "$RELEASE_JSON" | jq -r '
  .assets[]
  | select(.name | test("^quickshell-git-.*-x86_64\\.pkg\\.tar\\.zst$"))
  | .browser_download_url
' | head -n1)

# --- Find cpptrace (optional) ---
CPPTRACE_URL=$(echo "$RELEASE_JSON" | jq -r '
  .assets[]
  | select(.name | test("^cpptrace-.*\\.pkg\\.tar\\.zst$"))
  | .browser_download_url
' | head -n1)

if [[ -z "$QUICKSHELL_URL" || "$QUICKSHELL_URL" == "null" ]]; then
  echo "❌ Could not find quickshell package."
  exit 1
fi

QS_FILE=$(basename "$QUICKSHELL_URL")

# Extract version cleanly
LATEST_VERSION=$(echo "$QS_FILE" | sed -E 's/^quickshell-git-(.*)-x86_64\.pkg\.tar\.zst/\1/')

echo "Remote:  $LATEST_VERSION"
echo "------------------------------------------"

# --- Version check ---
UP_TO_DATE=false
if [[ -n "$INSTALLED_VERSION" ]]; then
  if [[ "$(vercmp "$INSTALLED_VERSION" "$LATEST_VERSION")" -ge 0 ]]; then
    UP_TO_DATE=true
  fi
fi

echo "Choose an action:"
if [[ "$UP_TO_DATE" == "true" ]]; then
  echo "1) Update (Already latest: $INSTALLED_VERSION)"
else
  echo "1) Update to $LATEST_VERSION"
fi
echo "2) Force reinstall"
echo "3) Cancel"
read -rp "Enter choice (1/2/3): " CHOICE

case "$CHOICE" in
  1)
    if [[ "$UP_TO_DATE" == "true" ]]; then
      echo "✅ Already up to date."
      exit 0
    fi
    ;;
  2)
    echo "🛠️ Force reinstalling..."
    ;;
  *)
    echo "Cancelled."
    exit 0
    ;;
esac

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT
cd "$TMP_DIR"

echo "📥 Downloading..."

aria2c -x 12 -s 12 -k 1M -o "$QS_FILE" "$QUICKSHELL_URL"

INSTALL_FILES=("$QS_FILE")

# Install cpptrace only if present
if [[ -n "$CPPTRACE_URL" && "$CPPTRACE_URL" != "null" ]]; then
  CPP_FILE=$(basename "$CPPTRACE_URL")
  aria2c -x 12 -s 12 -k 1M -o "$CPP_FILE" "$CPPTRACE_URL"
  INSTALL_FILES=("$CPP_FILE" "$QS_FILE")
fi

echo "📦 Installing..."
sudo pacman -U --noconfirm "${INSTALL_FILES[@]}"

echo "------------------------------------------"
echo "✅ Quickshell $LATEST_VERSION installed!"
echo "------------------------------------------"
